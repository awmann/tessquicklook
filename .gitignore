# ---------------------------------------------------------------------------
# IDL material -- NOT redistributable.
#
# The whole idl_compare/ tree is excluded: the .pro sources call into a private
# IDL library, run_idl.sh embeds local paths, and the .txt files are numerical
# output captured by running that library.  The files stay on disk for local
# use; they are simply never committed.
#
# Consequence: tests/test_spline_vs_idl.py and tests/test_decorr_vs_idl.py have
# no reference data in a fresh clone and will report "SKIPPED".  See
# "Running the tests" in the README.
# ---------------------------------------------------------------------------
idl_compare/

# Pipeline products -- large (GB scale) and fully reproducible from the code.
output/

# Generated by the example scripts.  expected_output.png is committed on
# purpose: the README embeds it as the reference result.
examples/example_lightcurve.png
examples/example_lightcurve.csv
examples/cadence_example.png

# Local analysis scripts for other projects (TIDYE Appa Task 2 linearity
# checks) that happen to be run from this directory -- not part of the package.
appa_task*.py

# Stray data products, in case a cache or output dir is pointed inside the repo
# (quaternion files are ~430 MB each; .part is an in-progress download).
*.fits
*.part

# Python
*.pyc
__pycache__/
*.egg-info/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/
